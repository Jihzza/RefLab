# RefLab frontend environment variables
# ---------------------------------------
# Copy this file to `.env.local` (which is git-ignored) and fill in the values
# from your Supabase project settings → API.
#
# SECURITY: Only VITE_-prefixed variables are bundled into the browser build and
# are therefore PUBLIC. Never put private secrets here — no Supabase service_role
# key, no Stripe secret key, no database password. Those belong only in Supabase
# Edge Function secrets / server environments, never in the frontend.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://iqebkyjcoqggwhausgje.supabase.co

# Supabase anon / public API key.
# Safe to expose in the browser: row-level security (RLS) enforces data access.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlxZWJreWpjb3FnZ3doYXVzZ2plIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njg3MzQ0NDEsImV4cCI6MjA4NDMxMDQ0MX0.OT-KMu4rOQGu1NFSNEXthwQ8KlEEbj-F1mqQJX6DTjI
