{
  "name": "reflab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-i18n.mjs && tsc -b && vite build && node scripts/generate-static-shells.mjs && node scripts/verify-static-shells.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:static": "node scripts/verify-static-shells.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate",
    "audit:ci": "npm audit --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.18",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.18.1",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  }
}
